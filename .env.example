# ============================================================================
# LOGICODIX — ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi `.env.local` untuk pengembangan lokal.
# JANGAN PERNAH melakukan commit file `.env` atau `.env.local` ke Git!
# ============================================================================

# --- 1. SUPABASE PUBLIC CONFIG (Aman untuk Client & Server) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# --- 2. SUPABASE SERVER-ONLY SECRET (HANYA UNTUK SERVER, JANGAN EXPOSE KE CLIENT) ---
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# --- 3. POSTGRESQL CONNECTION (Untuk Drizzle ORM & Migrations) ---
# Gunakan Transaction Pooler (Port 6543) untuk aplikasi runtime (prepare: false)
DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Gunakan Direct/Session Connection (Port 5432) untuk drizzle-kit push/migrate
DIRECT_URL="postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- 4. APPLICATION METADATA ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Logicodix UMKM Hub"
